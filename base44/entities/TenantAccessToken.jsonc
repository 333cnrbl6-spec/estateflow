{
  "name": "TenantAccessToken",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string",
      "description": "Reference to Tenant entity"
    },
    "tenant_email": {
      "type": "string",
      "description": "Tenant email address"
    },
    "property_id": {
      "type": "string",
      "description": "Reference to Property entity"
    },
    "unit_id": {
      "type": "string",
      "description": "Reference to Unit entity (optional)"
    },
    "token": {
      "type": "string",
      "description": "Secure access token (SHA-256 hash)"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "When token was created"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "When token expires"
    },
    "last_used": {
      "type": "string",
      "format": "date-time",
      "description": "Last time token was used to access portal"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Whether token is currently active"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "tenant_id",
    "tenant_email",
    "property_id",
    "token",
    "created_at",
    "expires_at"
  ]
}