{
  "name": "TenantAccessToken",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string"
    },
    "token": {
      "type": "string"
    },
    "property_id": {
      "type": "string"
    },
    "unit_id": {
      "type": "string"
    },
    "expires_at": {
      "type": "string",
      "format": "date"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "created_date": {
      "type": "string",
      "format": "date"
    },
    "last_accessed": {
      "type": "string",
      "format": "date"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "tenant_id",
    "token"
  ]
}