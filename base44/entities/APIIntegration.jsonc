{
  "name": "APIIntegration",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "service_name": {
      "type": "string"
    },
    "api_endpoint": {
      "type": "string"
    },
    "api_key_prefix": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive",
        "error"
      ],
      "default": "active"
    },
    "webhook_enabled": {
      "type": "boolean",
      "default": false
    },
    "webhook_url": {
      "type": "string"
    },
    "last_health_check": {
      "type": "string",
      "format": "date"
    },
    "sync_interval_minutes": {
      "type": "number",
      "default": 60
    },
    "auto_sync": {
      "type": "boolean",
      "default": true
    },
    "data_types": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "created_date": {
      "type": "string",
      "format": "date"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "name",
    "service_name"
  ]
}