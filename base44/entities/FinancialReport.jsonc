{
  "name": "FinancialReport",
  "type": "object",
  "properties": {
    "property_id": {
      "type": "string",
      "description": "Reference to Property entity"
    },
    "report_type": {
      "type": "string",
      "enum": [
        "profit_loss",
        "balance_sheet",
        "custom",
        "forecast"
      ],
      "description": "Type of report generated"
    },
    "report_period_start": {
      "type": "string",
      "format": "date",
      "description": "Report period start date"
    },
    "report_period_end": {
      "type": "string",
      "format": "date",
      "description": "Report period end date"
    },
    "generated_date": {
      "type": "string",
      "format": "date-time",
      "description": "When report was generated"
    },
    "generated_by": {
      "type": "string",
      "description": "Email of user who generated report"
    },
    "total_income": {
      "type": "number",
      "description": "Total income in pence"
    },
    "total_expenses": {
      "type": "number",
      "description": "Total expenses in pence"
    },
    "net_profit": {
      "type": "number",
      "description": "Net profit in pence"
    },
    "data_breakdown": {
      "type": "object",
      "description": "Detailed breakdown by category"
    },
    "document_url": {
      "type": "string",
      "description": "URL to generated PDF report"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "final",
        "archived"
      ],
      "default": "draft",
      "description": "Report status"
    }
  },
  "required": [
    "property_id",
    "report_type",
    "generated_date",
    "generated_by"
  ]
}