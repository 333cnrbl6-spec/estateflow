{
  "name": "DepositProtection",
  "type": "object",
  "properties": {
    "tenancy_id": {
      "type": "string",
      "description": "Reference to Tenancy/Tenant entity"
    },
    "property_id": {
      "type": "string",
      "description": "Reference to Property entity"
    },
    "unit_id": {
      "type": "string",
      "description": "Reference to Unit entity"
    },
    "tenant_id": {
      "type": "string",
      "description": "Reference to Tenant entity"
    },
    "landlord_id": {
      "type": "string",
      "description": "Reference to Landlord contact"
    },
    "deposit_amount": {
      "type": "number",
      "description": "Deposit amount in pence"
    },
    "scheme_type": {
      "type": "string",
      "enum": [
        "dps",
        "mydeposits",
        "tds",
        "custodial",
        "insured"
      ],
      "description": "Type of protection scheme"
    },
    "scheme_name": {
      "type": "string",
      "description": "Name of the registered scheme"
    },
    "scheme_reference": {
      "type": "string",
      "description": "Scheme reference/receipt number"
    },
    "scheme_contact": {
      "type": "string",
      "description": "Scheme contact details (phone/email)"
    },
    "protection_date": {
      "type": "string",
      "format": "date",
      "description": "Date deposit was protected within scheme"
    },
    "prescribed_information_served_date": {
      "type": "string",
      "format": "date-time",
      "description": "Date prescribed information was given to tenant"
    },
    "prescribed_info_method": {
      "type": "string",
      "enum": [
        "email",
        "post",
        "hand_delivered",
        "legal_document"
      ],
      "description": "Method prescribed info was delivered"
    },
    "prescribed_info_proof": {
      "type": "string",
      "description": "URL to proof of prescribed info delivery (email receipt, signature, etc.)"
    },
    "prescribed_info_content_url": {
      "type": "string",
      "description": "URL to served prescribed information document"
    },
    "prescribed_info_compliant": {
      "type": "boolean",
      "description": "Whether prescribed info includes all required details (scheme details, contact, dispute info, etc.)"
    },
    "tenancy_start_date": {
      "type": "string",
      "format": "date",
      "description": "Start date of tenancy"
    },
    "tenancy_end_date": {
      "type": "string",
      "format": "date",
      "description": "End date of tenancy"
    },
    "expected_return_date": {
      "type": "string",
      "format": "date",
      "description": "Expected return deadline (usually 30 days after tenancy end)"
    },
    "status": {
      "type": "string",
      "enum": [
        "not_protected",
        "protected",
        "prescribed_pending",
        "fully_compliant",
        "return_pending",
        "returned",
        "disputed",
        "non_compliant"
      ],
      "default": "not_protected",
      "description": "Current protection status"
    },
    "deductions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "deduction_id": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "amount": {
            "type": "number"
          },
          "reason_category": {
            "type": "string",
            "enum": [
              "cleaning",
              "damage",
              "unpaid_rent",
              "other"
            ]
          },
          "evidence_url": {
            "type": "string"
          },
          "approved_by_tenant": {
            "type": "boolean"
          },
          "date_proposed": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "description": "Proposed deductions from deposit"
    },
    "return_amount": {
      "type": "number",
      "description": "Amount being returned to tenant in pence"
    },
    "return_date": {
      "type": "string",
      "format": "date",
      "description": "Date deposit was returned"
    },
    "return_proof_url": {
      "type": "string",
      "description": "URL to proof of return (bank statement, receipt, etc.)"
    },
    "dispute_filed": {
      "type": "boolean",
      "description": "Whether tenant has disputed the deposit"
    },
    "dispute_details": {
      "type": "string",
      "description": "Details of dispute if filed"
    },
    "audit_trail": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "action": {
            "type": "string"
          },
          "performed_by": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          }
        }
      },
      "description": "Complete audit trail of all actions"
    },
    "legislation_compliant": {
      "type": "boolean",
      "description": "Overall compliance with Housing Act 2004 s.213-215"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "tenant_id",
    "property_id",
    "deposit_amount",
    "scheme_type",
    "protection_date",
    "prescribed_information_served_date"
  ]
}