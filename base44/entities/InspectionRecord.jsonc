{
  "name": "InspectionRecord",
  "type": "object",
  "properties": {
    "property_id": {
      "type": "string",
      "description": "Reference to Property entity"
    },
    "unit_id": {
      "type": "string",
      "description": "Reference to Unit entity (optional)"
    },
    "inspection_type": {
      "type": "string",
      "enum": [
        "general",
        "routine",
        "move_in",
        "move_out",
        "safety"
      ],
      "description": "Type of inspection"
    },
    "scheduled_date": {
      "type": "string",
      "format": "date",
      "description": "Date inspection is scheduled"
    },
    "completed_date": {
      "type": "string",
      "format": "date-time",
      "description": "When inspection was completed"
    },
    "status": {
      "type": "string",
      "enum": [
        "scheduled",
        "completed",
        "cancelled"
      ],
      "default": "scheduled",
      "description": "Inspection status"
    },
    "created_by": {
      "type": "string",
      "description": "Email of user who scheduled inspection"
    },
    "completed_by": {
      "type": "string",
      "description": "Email of user who completed inspection"
    },
    "checklist_data": {
      "type": "object",
      "description": "Checklist items and their completion status"
    },
    "findings": {
      "type": "string",
      "description": "Summary of inspection findings and notes"
    },
    "photos_count": {
      "type": "number",
      "default": 0,
      "description": "Number of photos taken during inspection"
    },
    "photos_urls": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "URLs to uploaded inspection photos"
    },
    "recurrence_parent_id": {
      "type": "string",
      "description": "Reference to parent recurring inspection"
    },
    "tenant_access_confirmed": {
      "type": "boolean",
      "default": false,
      "description": "Whether tenant confirmed access"
    },
    "notes": {
      "type": "string",
      "description": "Initial notes when scheduling inspection"
    }
  },
  "required": [
    "property_id",
    "inspection_type",
    "scheduled_date"
  ]
}