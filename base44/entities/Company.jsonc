{
  "name": "Company",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Company name"
    },
    "company_number": {
      "type": "string",
      "description": "Companies House registration number"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "dissolved",
        "dormant",
        "in_liquidation",
        "strike_off_pending"
      ],
      "default": "active"
    },
    "category": {
      "type": "string",
      "enum": [
        "core_property",
        "management",
        "freehold",
        "rtm_management",
        "service_charge_vehicle",
        "investment",
        "international",
        "associates",
        "other"
      ],
      "description": "Company category within the group"
    },
    "registered_address": {
      "type": "string"
    },
    "incorporation_date": {
      "type": "string",
      "format": "date"
    },
    "sic_code": {
      "type": "string",
      "description": "SIC code e.g. 68100, 68320, 98000"
    },
    "sic_description": {
      "type": "string",
      "description": "Human-readable SIC description"
    },
    "directors": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "appointed_date": {
            "type": "string",
            "format": "date"
          },
          "resigned_date": {
            "type": "string",
            "format": "date"
          }
        }
      }
    },
    "accounts_next_due": {
      "type": "string",
      "format": "date",
      "description": "Next accounts filing due date"
    },
    "accounts_last_made_up": {
      "type": "string",
      "format": "date"
    },
    "confirmation_next_due": {
      "type": "string",
      "format": "date",
      "description": "Next confirmation statement due date"
    },
    "confirmation_last_dated": {
      "type": "string",
      "format": "date"
    },
    "region": {
      "type": "string",
      "enum": [
        "london",
        "brighton",
        "blackpool",
        "ipswich",
        "leeds",
        "kettering",
        "other"
      ]
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "name"
  ]
}