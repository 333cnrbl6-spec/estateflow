{
  "name": "ClientMoneyProtection",
  "type": "object",
  "properties": {
    "managing_company_id": {
      "type": "string",
      "description": "Reference to Company entity (managing agent)"
    },
    "cmp_scheme": {
      "type": "object",
      "properties": {
        "scheme_name": {
          "type": "string",
          "enum": [
            "The Property Ombudsman",
            "LETTINGREDRESS",
            "none"
          ],
          "description": "Government-approved Client Money Protection scheme (required in England)"
        },
        "membership_required": {
          "type": "boolean",
          "default": true,
          "description": "Housing Act 2004 s.213 requirement for property management in England"
        },
        "member_number": {
          "type": "string"
        },
        "membership_active": {
          "type": "boolean"
        },
        "membership_start_date": {
          "type": "string",
          "format": "date"
        },
        "next_renewal_date": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "client_money_account": {
      "type": "object",
      "properties": {
        "account_type": {
          "type": "string",
          "enum": [
            "designated",
            "pooled"
          ],
          "description": "Designated = per leaseholder; Pooled = commingled but protected"
        },
        "bank_name": {
          "type": "string"
        },
        "account_number": {
          "type": "string",
          "description": "Last 4 digits only for security"
        },
        "sort_code": {
          "type": "string",
          "description": "Last 2 digits only for security"
        },
        "account_opened_date": {
          "type": "string",
          "format": "date"
        },
        "segregated_from_office_account": {
          "type": "boolean",
          "description": "Client money must be held separately from business funds"
        },
        "interest_bearing": {
          "type": "boolean"
        },
        "interest_paid_to": {
          "type": "string",
          "enum": [
            "leaseholders",
            "managing_agent",
            "deposit_scheme"
          ]
        }
      }
    },
    "money_held": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "property_id": {
            "type": "string"
          },
          "money_type": {
            "type": "string",
            "enum": [
              "service_charge_reserve",
              "deposit",
              "rent_payment",
              "insurance_escrow",
              "other"
            ]
          },
          "amount": {
            "type": "number"
          },
          "date_received": {
            "type": "string",
            "format": "date"
          },
          "on_behalf_of": {
            "type": "string",
            "description": "Leaseholder/property name"
          },
          "purpose": {
            "type": "string"
          },
          "expected_release_date": {
            "type": "string",
            "format": "date"
          }
        },
        "required": [
          "property_id",
          "money_type",
          "amount"
        ]
      }
    },
    "account_reconciliation": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "reconciliation_date": {
            "type": "string",
            "format": "date"
          },
          "reconciliation_frequency": {
            "type": "string",
            "enum": [
              "monthly",
              "quarterly"
            ],
            "default": "monthly"
          },
          "bank_balance": {
            "type": "number"
          },
          "held_on_behalf_total": {
            "type": "number"
          },
          "variance": {
            "type": "number",
            "description": "Difference between bank and held amounts"
          },
          "variance_explained": {
            "type": "boolean"
          },
          "explanation": {
            "type": "string"
          },
          "reconciliation_status": {
            "type": "string",
            "enum": [
              "balanced",
              "unbalanced",
              "investigating"
            ]
          }
        },
        "required": [
          "reconciliation_date",
          "bank_balance",
          "held_on_behalf_total"
        ]
      }
    },
    "interest_tracking": {
      "type": "object",
      "properties": {
        "interest_earned_ytd": {
          "type": "number"
        },
        "interest_distribution_policy": {
          "type": "string",
          "description": "Policy for allocating interest earned"
        },
        "last_interest_distribution": {
          "type": "object",
          "properties": {
            "date": {
              "type": "string",
              "format": "date"
            },
            "total_amount": {
              "type": "number"
            },
            "allocation_method": {
              "type": "string"
            }
          }
        }
      }
    },
    "dispute_resolution": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "dispute_date": {
            "type": "string",
            "format": "date"
          },
          "amount_in_dispute": {
            "type": "number"
          },
          "nature_of_dispute": {
            "type": "string"
          },
          "parties_involved": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "amount_held_pending_resolution": {
            "type": "number"
          },
          "resolution_status": {
            "type": "string",
            "enum": [
              "pending",
              "agreed",
              "cmp_scheme_claim",
              "court_judgment"
            ]
          },
          "resolution_date": {
            "type": "string",
            "format": "date"
          },
          "outcome": {
            "type": "string"
          }
        }
      }
    },
    "audit_and_compliance": {
      "type": "object",
      "properties": {
        "annual_audit_required": {
          "type": "boolean"
        },
        "last_audit_date": {
          "type": "string",
          "format": "date"
        },
        "next_audit_due": {
          "type": "string",
          "format": "date"
        },
        "audit_findings": {
          "type": "string"
        },
        "audit_qualified_opinion": {
          "type": "boolean"
        },
        "cmp_scheme_inspection": {
          "type": "object",
          "properties": {
            "last_inspection_date": {
              "type": "string",
              "format": "date"
            },
            "inspection_findings": {
              "type": "string"
            },
            "compliance_issues_noted": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "remediation_actions": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "action": {
                    "type": "string"
                  },
                  "completion_date": {
                    "type": "string",
                    "format": "date"
                  }
                }
              }
            }
          }
        }
      }
    },
    "claims_and_breaches": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "format": "date"
          },
          "type": {
            "type": "string",
            "enum": [
              "cmp_claim",
              "regulatory_breach",
              "audit_finding"
            ]
          },
          "description": {
            "type": "string"
          },
          "amount": {
            "type": "number"
          },
          "status": {
            "type": "string",
            "enum": [
              "reported",
              "under_investigation",
              "resolved",
              "paid"
            ]
          },
          "resolution_date": {
            "type": "string",
            "format": "date"
          }
        }
      }
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "managing_company_id",
    "cmp_scheme"
  ]
}