{
  "name": "AccountingIntegration",
  "type": "object",
  "properties": {
    "provider": {
      "type": "string",
      "enum": [
        "quickbooks",
        "xero"
      ],
      "description": "Accounting software provider"
    },
    "company_id": {
      "type": "string",
      "description": "Powell & Co company this integration is for"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "disconnected",
        "error"
      ],
      "default": "active"
    },
    "realm_id": {
      "type": "string",
      "description": "QuickBooks realm/company ID"
    },
    "tenant_id": {
      "type": "string",
      "description": "Xero tenant ID"
    },
    "last_sync_date": {
      "type": "string",
      "format": "date"
    },
    "sync_interval_hours": {
      "type": "number",
      "default": 24,
      "description": "Hours between automatic syncs"
    },
    "auto_sync_enabled": {
      "type": "boolean",
      "default": true
    },
    "sync_transactions": {
      "type": "boolean",
      "default": true,
      "description": "Sync rent/income transactions"
    },
    "sync_expenses": {
      "type": "boolean",
      "default": true,
      "description": "Sync expense transactions"
    },
    "sync_journal_entries": {
      "type": "boolean",
      "default": false
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "provider",
    "company_id"
  ]
}