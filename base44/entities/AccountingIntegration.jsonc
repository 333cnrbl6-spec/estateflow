{
  "name": "AccountingIntegration",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string",
      "description": "Reference to Company entity"
    },
    "package_type": {
      "type": "string",
      "enum": [
        "xero",
        "sage",
        "quickbooks",
        "freeagent",
        "wave",
        "freshbooks"
      ],
      "description": "Accounting software package"
    },
    "connection_status": {
      "type": "string",
      "enum": [
        "connected",
        "pending_auth",
        "disconnected",
        "error"
      ],
      "default": "pending_auth",
      "description": "Current connection status"
    },
    "access_token": {
      "type": "string",
      "description": "OAuth access token (encrypted in transit)"
    },
    "refresh_token": {
      "type": "string",
      "description": "OAuth refresh token (encrypted in transit)"
    },
    "tenant_id": {
      "type": "string",
      "description": "Tenant/Realm ID (e.g., Xero Tenant ID, QB Realm ID)"
    },
    "organization_id": {
      "type": "string",
      "description": "Organization ID for the connected account"
    },
    "last_synced": {
      "type": "string",
      "format": "date-time",
      "description": "When Chart of Accounts was last synced"
    },
    "last_sync_error": {
      "type": "string",
      "description": "Error message from last failed sync"
    },
    "sync_frequency": {
      "type": "string",
      "enum": [
        "realtime",
        "hourly",
        "daily",
        "weekly",
        "manual"
      ],
      "default": "daily",
      "description": "How often to sync data"
    },
    "auto_create_nominals": {
      "type": "boolean",
      "default": true,
      "description": "Automatically create Nominal records for new accounts"
    },
    "auto_sync_transactions": {
      "type": "boolean",
      "default": false,
      "description": "Automatically sync transactions from accounting package"
    },
    "auto_sync_invoices": {
      "type": "boolean",
      "default": false,
      "description": "Automatically sync invoices from accounting package"
    },
    "nominal_records_created": {
      "type": "number",
      "default": 0,
      "description": "Count of Nominal records created from this integration"
    },
    "transaction_sync_date": {
      "type": "string",
      "format": "date",
      "description": "From which date to sync historical transactions"
    },
    "authorized_by_user_id": {
      "type": "string",
      "description": "User ID who authorized this connection"
    },
    "authorization_date": {
      "type": "string",
      "format": "date-time",
      "description": "When the integration was authorized"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the access token expires"
    },
    "notes": {
      "type": "string",
      "description": "Additional integration notes"
    }
  },
  "required": [
    "company_id",
    "package_type"
  ]
}