{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "user"
      ],
      "default": "user"
    },
    "business_name": {
      "type": "string",
      "description": "User's business name for subscription"
    },
    "is_subscribed": {
      "type": "boolean",
      "default": false,
      "description": "Whether the user has an active subscription"
    },
    "current_demo_company_id": {
      "type": "string",
      "description": "ID of the currently active demo company \u2014 used to scope all pages to a single agent demo"
    },
    "trial_started_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the 14-day trial began"
    },
    "trial_ends_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the 14-day trial expires"
    },
    "subscription_status": {
      "type": "string",
      "enum": [
        "trial",
        "active",
        "past_due",
        "cancelled",
        "paused"
      ],
      "default": "trial",
      "description": "Current subscription status"
    },
    "stripe_customer_id": {
      "type": "string",
      "description": "Stripe customer ID for billing"
    },
    "stripe_subscription_id": {
      "type": "string",
      "description": "Stripe subscription ID"
    },
    "subscription_tier": {
      "type": "string",
      "enum": [
        "starter",
        "professional",
        "enterprise"
      ],
      "description": "Current pricing tier"
    },
    "properties_limit": {
      "type": "number",
      "description": "Max properties allowed per tier (0 = unlimited)"
    },
    "properties_used": {
      "type": "number",
      "default": 0,
      "description": "Current property count"
    }
  },
  "required": []
}