{
  "name": "OwnershipRelationship",
  "type": "object",
  "properties": {
    "from_entity_type": {
      "type": "string",
      "enum": [
        "person",
        "company",
        "property",
        "unit"
      ],
      "description": "Type of the source node"
    },
    "from_entity_id": {
      "type": "string",
      "description": "ID of the source entity (Contact, Company, Property, or Unit)"
    },
    "from_label": {
      "type": "string",
      "description": "Display name of the source node"
    },
    "to_entity_type": {
      "type": "string",
      "enum": [
        "person",
        "company",
        "property",
        "unit"
      ],
      "description": "Type of the target node"
    },
    "to_entity_id": {
      "type": "string",
      "description": "ID of the target entity"
    },
    "to_label": {
      "type": "string",
      "description": "Display name of the target node"
    },
    "relationship_type": {
      "type": "string",
      "enum": [
        "director_of",
        "psc_of",
        "owns_freehold",
        "holds_leasehold",
        "manages_block",
        "collects_ground_rent",
        "letting_agent_for",
        "rtm_company_for",
        "tenant_of",
        "beneficial_owner_of",
        "shareholder_of",
        "secretary_of",
        "service_charge_vehicle_for",
        "nominee_director_of",
        "offshore_owner_of",
        "ground_rent_fund_for"
      ],
      "description": "Nature of the relationship"
    },
    "relationship_label": {
      "type": "string",
      "description": "Human-readable edge label e.g. 'Director of', 'Holds leasehold of'"
    },
    "date_from": {
      "type": "string",
      "format": "date",
      "description": "When this relationship began (e.g. lease start, director appointment, RTM acquisition)"
    },
    "date_to": {
      "type": "string",
      "format": "date",
      "description": "When this relationship ended (e.g. director resignation, RTM dissolution, lease expiry). Null = currently active."
    },
    "is_historical": {
      "type": "boolean",
      "default": false,
      "description": "True if this relationship has ended (date_to is set). Used for timeline filtering."
    },
    "leaseholder_type": {
      "type": "string",
      "enum": [
        "investor",
        "owner_occupier",
        "nominee",
        "corporate",
        "offshore",
        "unknown"
      ],
      "description": "For holds_leasehold relationships: the nature of the leaseholder's interest"
    },
    "control_type": {
      "type": "string",
      "enum": [
        "direct",
        "beneficial",
        "nominee",
        "offshore_vehicle",
        "unknown"
      ],
      "description": "Nature of control \u2014 distinguishes nominal from beneficial directors/owners"
    },
    "notes": {
      "type": "string",
      "description": "Additional context or conflict-of-interest flags"
    },
    "conflict_of_interest": {
      "type": "boolean",
      "default": false,
      "description": "Flag if this relationship creates a conflict of interest"
    },
    "conflict_description": {
      "type": "string",
      "description": "Description of the conflict"
    },
    "auto_detected_coi": {
      "type": "boolean",
      "default": false,
      "description": "True if this COI was auto-detected by the system (not manually flagged)"
    },
    "coi_pattern": {
      "type": "string",
      "enum": [
        "leaseholder_controls_letting_agent",
        "rtm_director_controls_managing_agent",
        "freehold_and_rtm_same_controller",
        "service_charge_vehicle_same_directors",
        "offshore_freehold_no_psc",
        "nominee_director_high_volume",
        "managing_agent_controls_reserve_fund",
        "other"
      ],
      "description": "The detected COI pattern type \u2014 used for analytics and pattern training"
    },
    "verified": {
      "type": "boolean",
      "default": false,
      "description": "Whether verified via Companies House or Land Registry"
    },
    "source": {
      "type": "string",
      "enum": [
        "companies_house",
        "land_registry",
        "manual",
        "onboarding",
        "auto_detected"
      ],
      "description": "How this relationship was established"
    },
    "risk_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 100,
      "description": "Calculated risk score for this specific relationship (0=no risk, 100=critical)"
    },
    "subscriber_company_id": {
      "type": "string",
      "description": "The top-level subscriber company this chain belongs to"
    },
    "scenario_tag": {
      "type": "string",
      "description": "Training scenario this relationship belongs to e.g. 'reed_close_farnworth', 'adriatic_offshore', 'service_charge_vehicle'"
    }
  },
  "required": [
    "from_entity_type",
    "from_entity_id",
    "from_label",
    "to_entity_type",
    "to_entity_id",
    "to_label",
    "relationship_type"
  ]
}