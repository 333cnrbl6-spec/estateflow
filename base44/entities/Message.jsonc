{
  "name": "Message",
  "type": "object",
  "properties": {
    "entity_type": {
      "type": "string",
      "enum": [
        "maintenance_request",
        "general"
      ],
      "description": "Type of entity this message relates to"
    },
    "entity_id": {
      "type": "string",
      "description": "ID of the entity (e.g., maintenance request ID)"
    },
    "sender_email": {
      "type": "string",
      "description": "Email of message sender"
    },
    "sender_name": {
      "type": "string",
      "description": "Name of message sender"
    },
    "message_text": {
      "type": "string",
      "description": "Message content"
    },
    "is_read": {
      "type": "boolean",
      "default": false,
      "description": "Whether message has been read"
    }
  },
  "required": [
    "entity_type",
    "entity_id",
    "sender_email",
    "message_text"
  ]
}