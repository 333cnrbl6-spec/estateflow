{
  "name": "RecurringPayment",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string",
      "description": "Reference to Tenant entity"
    },
    "property_id": {
      "type": "string",
      "description": "Reference to Property entity"
    },
    "stripe_customer_id": {
      "type": "string",
      "description": "Stripe customer ID"
    },
    "stripe_subscription_schedule_id": {
      "type": "string",
      "description": "Stripe subscription schedule ID"
    },
    "payment_method_id": {
      "type": "string",
      "description": "Stripe payment method ID (saved card)"
    },
    "amount": {
      "type": "number",
      "description": "Monthly payment amount in GBP"
    },
    "currency": {
      "type": "string",
      "default": "gbp",
      "description": "Currency code"
    },
    "day_of_month": {
      "type": "number",
      "description": "Day of month for payment (1-31)"
    },
    "start_date": {
      "type": "string",
      "format": "date",
      "description": "When recurring payments start"
    },
    "next_payment_date": {
      "type": "string",
      "format": "date",
      "description": "Next scheduled payment date"
    },
    "last_payment_date": {
      "type": "string",
      "format": "date",
      "description": "Last successful payment date"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "paused",
        "cancelled",
        "failed"
      ],
      "default": "active",
      "description": "Recurring payment status"
    },
    "total_payments": {
      "type": "number",
      "default": 0,
      "description": "Total number of successful payments"
    },
    "total_amount_paid": {
      "type": "number",
      "default": 0,
      "description": "Total amount paid to date"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "tenant_id",
    "amount",
    "day_of_month",
    "start_date"
  ]
}