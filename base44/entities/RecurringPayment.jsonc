{
  "name": "RecurringPayment",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string",
      "description": "Reference to Tenant entity"
    },
    "property_id": {
      "type": "string",
      "description": "Reference to Property entity"
    },
    "unit_id": {
      "type": "string",
      "description": "Reference to Unit entity"
    },
    "stripe_subscription_id": {
      "type": "string",
      "description": "Stripe subscription ID"
    },
    "stripe_customer_id": {
      "type": "string",
      "description": "Stripe customer ID"
    },
    "payment_method_id": {
      "type": "string",
      "description": "Stripe payment method ID"
    },
    "monthly_amount": {
      "type": "number",
      "description": "Monthly rent amount in pence"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "paused",
        "cancelled"
      ],
      "default": "active",
      "description": "Status of recurring payment"
    },
    "start_date": {
      "type": "string",
      "format": "date-time",
      "description": "When recurring payments start"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "When recurring payment was created"
    },
    "last_payment_date": {
      "type": "string",
      "format": "date-time",
      "description": "Date of last successful payment"
    },
    "next_payment_date": {
      "type": "string",
      "format": "date-time",
      "description": "Scheduled date for next payment"
    },
    "cancelled_date": {
      "type": "string",
      "format": "date-time",
      "description": "When recurring payment was cancelled"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "tenant_id",
    "property_id",
    "stripe_subscription_id",
    "stripe_customer_id",
    "monthly_amount",
    "start_date"
  ]
}