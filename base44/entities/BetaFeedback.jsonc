{
  "name": "BetaFeedback",
  "type": "object",
  "properties": {
    "user_name": {
      "type": "string",
      "description": "Name of the beta tester"
    },
    "user_email": {
      "type": "string",
      "description": "Email for follow-up contact"
    },
    "user_company": {
      "type": "string",
      "description": "Company or agency name"
    },
    "user_phone": {
      "type": "string",
      "description": "Optional phone number for follow-up"
    },
    "feedback_type": {
      "type": "string",
      "enum": [
        "bug",
        "issue",
        "suggestion",
        "new_feature",
        "improvement",
        "praise",
        "other"
      ],
      "description": "Category of feedback"
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ],
      "default": "medium",
      "description": "Severity or urgency as reported"
    },
    "subject": {
      "type": "string",
      "description": "Short summary of the feedback"
    },
    "description": {
      "type": "string",
      "description": "Full feedback conversation transcript and detail"
    },
    "page_context": {
      "type": "string",
      "description": "Which page or module the feedback relates to"
    },
    "module_area": {
      "type": "string",
      "description": "Specific module or feature area"
    },
    "status": {
      "type": "string",
      "enum": [
        "new",
        "acknowledged",
        "in_review",
        "planned",
        "resolved",
        "wont_fix"
      ],
      "default": "new",
      "description": "Internal tracking status"
    },
    "follow_up_required": {
      "type": "boolean",
      "default": false,
      "description": "Whether a follow-up call/email is needed"
    },
    "internal_notes": {
      "type": "string",
      "description": "Internal team notes on this feedback"
    },
    "submitted_at": {
      "type": "string",
      "format": "date-time",
      "description": "When feedback was submitted"
    }
  },
  "required": [
    "feedback_type",
    "subject",
    "description"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}