{
  "name": "CRMInteraction",
  "type": "object",
  "properties": {
    "interaction_type": {
      "type": "string",
      "enum": [
        "email",
        "letter",
        "phone_call",
        "meeting",
        "sms",
        "whatsapp",
        "legal_notice",
        "complaint",
        "note"
      ],
      "default": "email"
    },
    "direction": {
      "type": "string",
      "enum": [
        "inbound",
        "outbound",
        "internal"
      ],
      "default": "outbound"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "subject": {
      "type": "string"
    },
    "body": {
      "type": "string",
      "description": "Content / summary of the interaction"
    },
    "contact_name": {
      "type": "string"
    },
    "contact_email": {
      "type": "string"
    },
    "contact_phone": {
      "type": "string"
    },
    "contact_type": {
      "type": "string",
      "enum": [
        "tenant",
        "leaseholder",
        "contractor",
        "solicitor",
        "accountant",
        "surveyor",
        "local_authority",
        "tribunal",
        "other"
      ]
    },
    "linked_property_id": {
      "type": "string"
    },
    "linked_tenant_id": {
      "type": "string"
    },
    "linked_company_id": {
      "type": "string"
    },
    "linked_maintenance_id": {
      "type": "string"
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "normal",
        "high",
        "urgent"
      ],
      "default": "normal"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "pending_reply",
        "resolved",
        "closed"
      ],
      "default": "open"
    },
    "follow_up_date": {
      "type": "string",
      "format": "date"
    },
    "attachment_url": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "interaction_type",
    "date",
    "subject",
    "contact_name"
  ]
}