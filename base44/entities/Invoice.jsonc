{
  "name": "Invoice",
  "type": "object",
  "properties": {
    "service_id": {
      "type": "string",
      "description": "Reference to OutOfHoursService entity"
    },
    "company_id": {
      "type": "string",
      "description": "Reference to Company entity"
    },
    "invoice_number": {
      "type": "string",
      "description": "Unique invoice identifier e.g. INV-2026-001"
    },
    "billing_period_start": {
      "type": "string",
      "format": "date",
      "description": "Start of billing period"
    },
    "billing_period_end": {
      "type": "string",
      "format": "date",
      "description": "End of billing period"
    },
    "service_tier": {
      "type": "string",
      "enum": [
        "basic",
        "standard",
        "premium",
        "enterprise"
      ],
      "description": "Service tier at time of invoice"
    },
    "amount": {
      "type": "number",
      "description": "Invoice amount in GBP"
    },
    "currency": {
      "type": "string",
      "default": "GBP",
      "description": "Currency code"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "issued",
        "sent",
        "viewed",
        "paid",
        "overdue",
        "cancelled"
      ],
      "default": "draft",
      "description": "Invoice status"
    },
    "issue_date": {
      "type": "string",
      "format": "date",
      "description": "Date invoice was issued"
    },
    "due_date": {
      "type": "string",
      "format": "date",
      "description": "Payment due date"
    },
    "paid_date": {
      "type": "string",
      "format": "date",
      "description": "Date payment received"
    },
    "payment_method": {
      "type": "string",
      "enum": [
        "stripe",
        "bank_transfer",
        "manual",
        "none"
      ],
      "default": "none",
      "description": "Payment method used"
    },
    "stripe_invoice_id": {
      "type": "string",
      "description": "Stripe invoice ID for tracking"
    },
    "stripe_payment_intent_id": {
      "type": "string",
      "description": "Stripe payment intent ID"
    },
    "payment_status": {
      "type": "string",
      "enum": [
        "unpaid",
        "pending",
        "succeeded",
        "failed",
        "cancelled"
      ],
      "default": "unpaid",
      "description": "Payment processing status"
    },
    "line_items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          },
          "unit_price": {
            "type": "number"
          },
          "amount": {
            "type": "number"
          }
        }
      },
      "description": "Itemized line items"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "service_id",
    "company_id",
    "invoice_number",
    "billing_period_start",
    "billing_period_end",
    "amount",
    "issue_date",
    "due_date"
  ]
}