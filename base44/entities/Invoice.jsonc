{
  "name": "Invoice",
  "type": "object",
  "properties": {
    "maintenance_request_id": {
      "type": "string",
      "description": "Reference to MaintenanceRequest entity"
    },
    "contractor_id": {
      "type": "string",
      "description": "Reference to Contact (contractor)"
    },
    "amount": {
      "type": "number",
      "description": "Invoice amount in GBP"
    },
    "description": {
      "type": "string",
      "description": "Invoice description and work details"
    },
    "document_url": {
      "type": "string",
      "description": "URL to uploaded invoice PDF/image"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending_approval",
        "approved",
        "rejected",
        "paid"
      ],
      "default": "pending_approval",
      "description": "Invoice approval status"
    },
    "submitted_by": {
      "type": "string",
      "description": "Email of contractor who submitted invoice"
    },
    "submitted_date": {
      "type": "string",
      "format": "date-time",
      "description": "When invoice was submitted"
    },
    "approved_by": {
      "type": "string",
      "description": "Email of person who approved/rejected"
    },
    "approved_date": {
      "type": "string",
      "format": "date-time",
      "description": "When invoice was approved/rejected"
    },
    "approval_notes": {
      "type": "string",
      "description": "Notes on approval or rejection"
    },
    "paid_date": {
      "type": "string",
      "format": "date-time",
      "description": "When invoice was paid"
    },
    "payment_reference": {
      "type": "string",
      "description": "Payment reference or transaction ID"
    },
    "notes": {
      "type": "string",
      "description": "Additional notes"
    }
  },
  "required": [
    "maintenance_request_id",
    "amount",
    "document_url",
    "submitted_by"
  ]
}