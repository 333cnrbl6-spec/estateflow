{
  "name": "MaintenanceRequest",
  "type": "object",
  "properties": {
    "property_id": {
      "type": "string",
      "description": "Reference to Property"
    },
    "unit_id": {
      "type": "string",
      "description": "Reference to Unit"
    },
    "tenant_id": {
      "type": "string",
      "description": "Reference to Tenant who submitted request"
    },
    "title": {
      "type": "string",
      "description": "Brief description of issue (e.g., 'Leaky tap in bathroom')"
    },
    "description": {
      "type": "string",
      "description": "Detailed description of the problem"
    },
    "category": {
      "type": "string",
      "enum": [
        "plumbing",
        "electrical",
        "heating",
        "appliance",
        "structural",
        "decoration",
        "other"
      ],
      "description": "Type of maintenance needed"
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "emergency"
      ],
      "default": "medium",
      "description": "Urgency level"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "assigned",
        "in_progress",
        "resolved",
        "closed"
      ],
      "default": "pending",
      "description": "Current lifecycle stage"
    },
    "assigned_contractor_id": {
      "type": "string",
      "description": "Reference to Vendor assigned"
    },
    "assigned_contractor_name": {
      "type": "string",
      "description": "Cached contractor name for quick display"
    },
    "assigned_at": {
      "type": "string",
      "format": "date-time",
      "description": "When contractor was assigned"
    },
    "scheduled_date": {
      "type": "string",
      "format": "date",
      "description": "Scheduled completion date"
    },
    "completed_date": {
      "type": "string",
      "format": "date-time",
      "description": "When work was completed"
    },
    "notes": {
      "type": "string",
      "description": "Manager/contractor notes"
    },
    "photo_urls": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Photos of the issue"
    },
    "contact_phone": {
      "type": "string",
      "description": "Tenant contact number"
    },
    "contact_email": {
      "type": "string",
      "description": "Tenant email for notifications"
    }
  },
  "required": [
    "property_id",
    "unit_id",
    "tenant_id",
    "title",
    "category"
  ]
}