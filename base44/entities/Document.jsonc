{
  "name": "Document",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string",
      "description": "Reference to Tenant entity"
    },
    "property_id": {
      "type": "string",
      "description": "Reference to Property entity"
    },
    "unit_id": {
      "type": "string",
      "description": "Reference to Unit entity"
    },
    "document_type": {
      "type": "string",
      "enum": [
        "ID Document",
        "Proof of Residency",
        "Signed Agreement",
        "Bank Statement",
        "Employment Letter",
        "Tenancy Agreement",
        "Inspection Report",
        "Certificate",
        "Other"
      ],
      "description": "Type of document"
    },
    "file_name": {
      "type": "string",
      "description": "Original file name"
    },
    "file_url": {
      "type": "string",
      "description": "URL to uploaded file"
    },
    "file_size": {
      "type": "number",
      "description": "File size in bytes"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending_review",
        "approved",
        "rejected",
        "archived"
      ],
      "default": "pending_review",
      "description": "Review status"
    },
    "uploaded_by": {
      "type": "string",
      "description": "Email of person who uploaded document"
    },
    "uploaded_date": {
      "type": "string",
      "format": "date-time",
      "description": "When document was uploaded"
    },
    "reviewed_by": {
      "type": "string",
      "description": "Email of reviewer"
    },
    "reviewed_date": {
      "type": "string",
      "format": "date-time",
      "description": "When document was reviewed"
    },
    "review_notes": {
      "type": "string",
      "description": "Notes from reviewer"
    },
    "expiry_date": {
      "type": "string",
      "format": "date",
      "description": "If document has expiration (e.g., ID, certificate)"
    }
  },
  "required": [
    "document_type",
    "file_name",
    "file_url"
  ]
}