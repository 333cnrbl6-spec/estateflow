{
  "name": "Contact",
  "type": "object",
  "properties": {
    "full_name": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "contact_type": {
      "type": "string",
      "enum": [
        "director",
        "contractor",
        "solicitor",
        "accountant",
        "agent",
        "surveyor",
        "managing_agent",
        "insurance_broker",
        "other"
      ]
    },
    "company_name": {
      "type": "string"
    },
    "related_company_id": {
      "type": "string",
      "description": "ID of the Company entity this contact belongs to \u2014 used for demo scoping"
    },
    "address": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "full_name"
  ]
}