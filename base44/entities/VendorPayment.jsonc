{
  "name": "VendorPayment",
  "type": "object",
  "properties": {
    "vendor_id": {
      "type": "string",
      "description": "Reference to Vendor entity"
    },
    "related_work_order_id": {
      "type": "string",
      "description": "Reference to MaintenanceOrder or Task entity"
    },
    "service_agreement_id": {
      "type": "string",
      "description": "Reference to ServiceAgreement entity (if from agreement)"
    },
    "invoice_number": {
      "type": "string",
      "description": "Vendor invoice number"
    },
    "description": {
      "type": "string",
      "description": "Payment description/service provided"
    },
    "amount": {
      "type": "number",
      "description": "Amount in pence"
    },
    "invoice_date": {
      "type": "string",
      "format": "date",
      "description": "Invoice date"
    },
    "due_date": {
      "type": "string",
      "format": "date",
      "description": "Payment due date"
    },
    "payment_date": {
      "type": "string",
      "format": "date",
      "description": "When payment was made"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "overdue",
        "paid",
        "cancelled"
      ],
      "default": "pending",
      "description": "Payment status"
    },
    "payment_method": {
      "type": "string",
      "enum": [
        "bank_transfer",
        "cheque",
        "cash",
        "card",
        "other"
      ],
      "description": "Payment method used"
    },
    "reference_number": {
      "type": "string",
      "description": "Bank transfer reference or cheque number"
    },
    "invoice_url": {
      "type": "string",
      "description": "URL to invoice document"
    },
    "notes": {
      "type": "string",
      "description": "Additional notes"
    }
  },
  "required": [
    "vendor_id",
    "amount",
    "invoice_date",
    "due_date"
  ]
}