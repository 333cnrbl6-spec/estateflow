{
  "name": "DocumentTemplate",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Template name e.g. Section 21 Notice, Tenancy Agreement"
    },
    "category": {
      "type": "string",
      "enum": [
        "eviction_notice",
        "tenancy_agreement",
        "deposit_protection_notice",
        "gas_safety_cert",
        "epc",
        "inventory",
        "inspection_report",
        "maintenance_notice",
        "rent_increase",
        "other"
      ]
    },
    "jurisdiction": {
      "type": "string",
      "enum": [
        "england",
        "wales",
        "scotland",
        "ni"
      ]
    },
    "template_content": {
      "type": "string",
      "description": "HTML/text template with placeholders like {{tenant_name}}, {{property_address}}"
    },
    "required_fields": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "List of required placeholder fields"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "name",
    "category",
    "jurisdiction",
    "template_content"
  ]
}