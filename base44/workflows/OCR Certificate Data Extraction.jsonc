{
  "name": "OCR Certificate Data Extraction",
  "description": "Automatically extracts certificate data (expiry date, certificate number, contractor details) from uploaded PDF certificates using OCR and updates the entity record",
  "trigger": {
    "condition": "${ (.trigger.changed_fields | index(\"document_url\") != null) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "create",
        "update"
      ],
      "entity_name": "SafetyCertificate"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "ocr_certificate_data_extraction",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "extractCertificateData",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "extractCertificateData"
  }
}