{
  "name": "Auto-sync Chart of Accounts on Integration Connect",
  "description": "Automatically syncs Chart of Accounts from connected accounting packages (Xero, Sage, QuickBooks) into Nominal records when integration status changes to 'connected'.",
  "trigger": {
    "condition": "${ (.trigger.data.connection_status == \"connected\") }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "create",
        "update"
      ],
      "entity_name": "AccountingIntegration"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "auto_sync_chart_of_accounts_on_integration_connect",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "onAccountingIntegrationCreated",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "onAccountingIntegrationCreated"
  }
}