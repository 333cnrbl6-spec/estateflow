{
  "name": "OCR Gas Safety Certificate Extraction",
  "description": "Automatically extracts Gas Safety Certificate data from uploaded CP12 PDFs using OCR",
  "trigger": {
    "condition": "${ (.trigger.changed_fields | index(\"document_url\") != null) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "create",
        "update"
      ],
      "entity_name": "GasSafetyCertificate"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "ocr_gas_safety_certificate_extraction",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "extractCertificateData",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "extractCertificateData"
  }
}