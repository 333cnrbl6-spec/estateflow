{
  "name": "Offer Status Change Notifications",
  "description": "Automatically send SMS and email notifications to buyers when their offer status changes (accepted, rejected, counter_offered)",
  "trigger": {
    "condition": "${ (.trigger.changed_fields | index(\"status\") != null) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "Offer"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "offer_status_change_notifications",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "onOfferStatusChange",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "onOfferStatusChange"
  }
}