{
  "name": "Compliance Rule Status Change Workflow",
  "description": "Automatically triggers tasks, alerts, and audit logs when a ComplianceRule status changes to overdue",
  "trigger": {
    "condition": "${ ((.trigger.changed_fields | index(\"status\") != null) or (.trigger.data.status == \"overdue\")) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "ComplianceRule"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "compliance_rule_status_change_workflow",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "complianceRuleWorkflowHandler",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "complianceRuleWorkflowHandler"
  }
}